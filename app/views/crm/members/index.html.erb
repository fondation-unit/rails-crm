<div class="d-flex w-100 justify-content-between">
  <h1><%= I18n.t('members.members') %></h1>
  <div>
    <%= link_to I18n.t('members.add'), crm.new_member_path, class: 'btn btn-primary align-self-center' %>
    <%= link_to I18n.t('members.import'), crm.member_import_form_path, class: 'btn btn-primary align-self-center' %>
  </div>
</div>

<%=
  render partial: 'crm/members/parts/search_bar',
         locals: {
           path: crm.search_members_path,
           translate: 'organizations',
           translate_list: 'organizations.statuses',
           filters: {
             status: Crm::Organization.statuses,
           },
         }
%>

<div id="search_results">
  <%= render 'list', records: @records %>
</div>

<div id="search_pagination" data-turbo-prefetch="false">
  <%= render 'shared/pagy', pagy: @pagy %>
</div>

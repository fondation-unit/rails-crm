<table class="table" data-controller="sortable">
  <thead>
    <tr>
      <th scope="col" data-action="click->sortable#sort" data-sortable-column-value="<%= 'id' %>">#</th>
      <th scope="col">
        <%= 'Logo' %>
      </th>
      <th scope="col" data-action="click->sortable#sort" data-sortable-column-value="<%= 'name' %>">
        <%= I18n.t('members.institution') %>
      </th>
      <th scope="col">
        <%= I18n.t('address') %>
      </th>
      <th scope="col">
        <%= I18n.t('zip_code') %>
      </th>
      <th scope="col" data-action="click->sortable#sort" data-sortable-column-value="<%= 'city' %>">
        <%= I18n.t('city') %>
      </th>
      <th scope="col" data-action="click->sortable#sort" data-sortable-column-value="<%= 'status' %>">
        <%= I18n.t('members.organizations.status') %>
      </th>
      <th scope="col" data-action="click->sortable#sort" data-sortable-column-value="<%= 'user_id' %>">
        <%= I18n.t('members.organizations.user_id') %>
      </th>
      <th scope="col"></th>
      <th scope="col"></th>
      <th scope="col"></th>
    </tr>
  </thead>
  <tbody>
    <% records.each_with_index do |c| %>
      <tr class="<%= Crm::OrganizationHelper.status_class(c) %>">
        <td><%= c.id %></td>
        <td><%= c.logo.attached? ? image_tag(c.logo.variant(:thumb), { style: 'max-width: 60px' }) : nil %></td>
        <td><%= link_to c.name, crm.organization_path(c) %></td>
        <td><%= c.address %></td>
        <td><%= c.zip_code %></td>
        <td><%= c.city %></td>
        <td><%= I18n.t("members.organizations.statuses.#{c.status}") %></td>
        <td><%= Crm::UserHelper.full_name(c.user) %></td>
        <td><%= link_to I18n.t('notes.add'), crm.new_organization_note_path(c), { class: 'btn btn-info' } %></td>
        <td><%= link_to I18n.t('edit'), crm.edit_organization_path(c) %></td>
        <td>
          <%=
            link_to I18n.t('delete'),
                    crm.organization_path(c),
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: I18n.t('members.organizations.validation_delete'),
                    }
          %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

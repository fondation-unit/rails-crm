<div class="d-flex w-100 justify-content-between">
    <h1><%= I18n.t('members.member_type.type_members') %></h1>
    <%= link_to I18n.t('members.member_type.add'), new_admin_member_type_path, class: 'btn btn-primary align-self-center' %>
</div>
<%=
  render 'shared/tables/sortable_table',
         headers: [[:id, '#'], [:name, 'Nom'], [:edit, ''], [:delete, '']],
         objects: @records,
         pagy: @pagy,
         columns: %w[id name edit delete],
         formatters: {
           edit: ->(member_type) { link_to I18n.t('edit'), edit_admin_member_type_path(member_type) },
           delete: ->(member_type) {
             link_to I18n.t('delete'),
                     admin_member_type_path(member_type),
                     data: {
                       turbo_method: :delete,
                       turbo_confirm: I18n.t('members.member_type.validation_delete'),
                     }
           },
         }
%>
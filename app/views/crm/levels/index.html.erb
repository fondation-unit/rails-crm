<div class="d-flex w-100 justify-content-between">
  <h1><%= I18n.t('members.level.title') %></h1>
  <%= link_to I18n.t('members.level.add'), crm.new_level_path, class: 'btn btn-primary align-self-center' %>
</div>
<%=
  render 'crm/shared/sortable_table',
         headers: [[:id, '#'], [:name, 'Nom'], [:edit, ''], [:delete, '']],
         objects: @records,
         pagy: @pagy,
         columns: %w[id name edit delete],
         formatters: {
           edit: ->(level) { link_to I18n.t('edit'), crm.edit_level_path(level) },
           delete: ->(level) {
             link_to I18n.t('delete'),
                     crm.level_path(level),
                     data: {
                       turbo_method: :delete,
                       turbo_confirm: I18n.t('members.level.validation_delete'),
                     }
           },
         }
%>

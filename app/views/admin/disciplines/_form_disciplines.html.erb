<%= form_with url: url, model: discipline do |f| %>
<div class="form-group my-4">
    <%= f.label :name, I18n.t('members.discipline.name') %>
    <%= f.text_field :name, required: true, class: 'form-control' %>
</div>
<button type="submit" class="btn btn-primary mb-5">
    <% if @discipline.persisted? %>
    <%= I18n.t('update') %>
    <% else %>
    <%= I18n.t('create') %>
    <% end %>
</button>
<% end %>
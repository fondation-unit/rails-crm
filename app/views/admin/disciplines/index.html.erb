<div class="d-flex w-100 justify-content-between">
    <h1><%= I18n.t('members.discipline.title') %></h1>
    <%= link_to I18n.t('members.discipline.add'), new_admin_discipline_path, class: 'btn btn-primary align-self-center' %>
</div>
<%=
  render 'shared/tables/sortable_table',
         headers: [[:id, '#'], [:name, 'Nom'], [:edit, ''], [:delete, '']],
         objects: @records,
         pagy: @pagy,
         columns: %w[id name edit delete],
         formatters: {
           edit: ->(discipline) { link_to I18n.t('edit'), edit_admin_discipline_path(discipline) },
           delete: ->(discipline) {
             link_to I18n.t('delete'),
                     admin_discipline_path(discipline),
                     data: {
                       turbo_method: :delete,
                       turbo_confirm: I18n.t('members.discipline.validation_delete'),
                     }
           },
         }
%>
<div class="d-flex w-100 justify-content-between">
  <h1 class="mb-4"><%= I18n.t('members.members') %></h1>
  <%= link_to I18n.t('members.add'), new_admin_member_path, class: 'btn btn-primary align-self-center' %>
</div>
<%=
  render 'shared/tables/sortable_table',
         headers: [
           [:id, '#'],
           [:organizations, I18n.t('members.institution')],
           [:first_name, I18n.t('first_name')],
           [:last_name, I18n.t('last_name')],
           [:email_address, I18n.t('email_address')],
           [:phone_number, I18n.t('phone_number')],
           [:notes, ''],
           [:edit, ''],
           [:delete, ''],
         ],
         objects: @records,
         pagy: @pagy,
         columns: %w[id organizations_names first_name last_name email_address phone_number notes edit delete],
         formatters: {
           edit: ->(member) { link_to I18n.t('edit'), edit_admin_member_path(member) },
           delete: ->(member) {
             link_to I18n.t('delete'),
                     admin_member_path(member),
                     data: {
                       turbo_method: :delete,
                       turbo_confirm: I18n.t('members.validation_delete'),
                     }
           },
           email_address: ->(member) { mail_to member.email_address, member.email_address },
           first_name: ->(member) { link_to member.first_name, admin_member_path(member.id) },
           last_name: ->(member) { link_to member.last_name, admin_member_path(member.id) },
           organizations_names: ->(member) {
             raw member.organizations_names.map { |wl| link_to wl[:name], admin_organization_path(wl[:id]) }.join(', ')
           },
           notes: ->(member) {
             link_to I18n.t('notes.add'), admin_new_member_note_path(member.id), { class: 'btn btn-info' }
           },
         }
%>

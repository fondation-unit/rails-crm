<div class="d-flex w-100 justify-content-between">
    <h1>Les membres</h1>
    <%= link_to 'Ajouter un membre', new_admin_member_path, class: 'btn btn-primary align-self-center' %>
</div>
<%=
  render 'shared/tables/sortable_table',
         headers: [
           [:id, '#'],
           [:organizations, 'Institution'],
           [:first_name, 'Prénom'],
           [:last_name, 'Nom'],
           [:email_address, 'Adresse mail'],
           [:phone_number, 'Téléphone'],
           [:edit, ''],
           [:delete, ''],
         ],
         objects: @records,
         pagy: @pagy,
         columns: %w[id organizations_names first_name last_name email_address phone_number edit delete],
         formatters: {
           edit: ->(member) { link_to 'Editer', edit_admin_member_path(member) },
           delete: ->(member) {
             link_to 'Supprimer',
                     admin_member_path(member),
                     data: {
                       turbo_method: :delete,
                       turbo_confirm: 'Etes-vous sur de vouloir effacer ce membre ?',
                     }
           },
           email_address: ->(member) { mail_to member.email_address, member.email_address },
           first_name: ->(member) { link_to member.first_name, admin_member_path(member.id) },
           last_name: ->(member) { link_to member.last_name, admin_member_path(member.id) },
           organizations_names: ->(member) { raw member.organizations_names.map{|wl| link_to wl[:name], admin_organization_path(wl[:id])}.join(', ') },
         }
%>
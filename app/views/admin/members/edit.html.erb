<h1><%= I18n.t('members.add') %></h1>

<%=
  render 'form_members', member: @member, url: admin_member_path(@member), member_types: @member_types, method: 'patch'
%>

<div class="d-flex flex-md-row justify-content-between align-items-center">
  <h2 class="mb-4">Les notes</h2>
  <%= link_to I18n.t('notes.add'), admin_new_note_path(@member.id), class: 'btn btn-primary align-self-center' %>
</div>

<%=
  render 'shared/tables/sortable_table',
         headers: [
           [:contact_type, I18n.t('notes.contact_type')],
           [:public, I18n.t('notes.public')],
           [:content, I18n.t('notes.content')],
           [:created_at, I18n.t('notes.created_at')],
           [:user_id, I18n.t('notes.created_by')],
           [:edit, ''],
           [:delete, ''],
         ],
         objects: @notes,
         pagy: @pagy,
         columns: %w[contact_type public content created_at user_id edit delete],
         formatters: {
           edit: ->(note) { link_to I18n.t('edit'), edit_admin_note_path(note) if policy(note).update? },
           delete: ->(note) {
             if policy(note).destroy?
               link_to I18n.t('delete'),
                       admin_note_path(note),
                       data: {
                         turbo_method: :delete,
                         turbo_confirm: I18n.t('notes.validation_delete'),
                       }
             end
           },
           public: ->(note) {
             raw(
               if note.public != true
                 '<i class="fa-solid fa-xmark text-danger"></i>'
               else
                 '<i class="fa-solid fa-check text-success"></i>'
               end,
             )
           },
           created_at: ->(note) { date_readable(note.created_at) },
           content: ->(note) { note_excerpt(note.content) },
           user_id: ->(note) {
             is_current_user?(note.user&.id) ? I18n.t('notes.moi') : note.user.first_name + ' ' + note.user.last_name
           },
           contact_type: ->(note) { note_contact_type(note) },
         }
%>

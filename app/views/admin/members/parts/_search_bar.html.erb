<%# stimulus controller "search-bar" %>
<div data-controller="search-bar">
    <%= form_with url: path, method: :get, data: { "search-bar-target": "form" } do |f| %>
    <div class="d-flex  ">
        <div class="input-group mb-3">
            <span class="input-group-text" id="q">
                <!--          <i class="bi bi-search position-relative"></i>-->
                <i class="fa-solid fa-magnifying-glass"></i>
            </span>
            <%=
          f.search_field :q,
                         data: {
                           action: 'input->search-bar#search',
                         },
                         class: 'form-control search-field',
                         placeholder: t(:search).capitalize,
                         value: params['q'],
                         autocomplete: 'off',
                         aria: {
                           label: t(:search),
                           describedby: 'q',
                         }
        %>
        </div>
    </div>
    <div>
        <%= f.label 'Choisissez une institution :' %>
        <%=
        select_tag 'filters[organization_ids]',
                   options_from_collection_for_select(@organizations, :id, :name),
                   include_blank: true,
                   data: {
                     action: 'change->search-bar#search',
                   }
      %>
    </div>
    <div class="d-flex align-items-center">
        <%= hidden_field_tag 'filters[__sent]', '1' %>
        <% filters.each do |filter_name, values| %>
        <h3><%= I18n.t("members.#{translate}.#{filter_name}") %></h3>

        <% values.each_with_index do |(key, value), index| %>
        <div class="form-check form-check-inline">
            <%=
              check_box_tag "filters[#{filter_name}][]",
                            value,
                            active_filter?(filter_name, value),
                            id: "filterCheckbox_#{filter_name}_#{index}",
                            class: 'mx-2 form-check-input',
                            data: {
                              action: 'change->search-bar#search',
                            }
            %>
            <label class="form-check-label" for="<%= "filterCheckbox_#{filter_name}_#{index}" %>">
                <%= I18n.t("members.#{translate_list}.#{key}") %>
            </label>
        </div>
        <% end %>
        <div class="d-flex flex-column w-100">
            <h3><%= I18n.t("investments.investments") %></h3>
            <% @investments.each_with_index do |i, index| %>

            <div class="form-check form-check-inline">
                <%=
              check_box_tag "filters[investment_ids][]",
                            i.id,
                            active_filter?(@investments, i.id),
                            id: "filterCheckbox_investments_#{index}",
                            class: 'mx-2 form-check-input',
                            data: {
                              action: 'change->search-bar#search',
                            }
            %>
                <label class="form-check-label" for="<%= "filterCheckbox_investments_#{index}" %>">
                    <%= i.name %>
                </label>
            </div>
            <% end %>
        </div>
        <% end %>
    </div>
    <% end %>
</div>
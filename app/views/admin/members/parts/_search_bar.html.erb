<%# stimulus controller "search-bar" %>
<div data-controller="search-bar">
    <%= form_with url: path, method: :get, data: { "search-bar-target": "form" } do |f| %>
    <div class="d-flex">
        <div class="input-group mb-3">
            <span class="input-group-text" id="q">
                <!--          <i class="bi bi-search position-relative"></i>-->
                <i class="fa-solid fa-magnifying-glass"></i>
            </span>
            <%=
          f.search_field :q,
                         data: {
                           action: 'input->search-bar#search',
                         },
                         class: 'form-control search-field',
                         placeholder: t(:search).capitalize,
                         value: params['q'],
                         autocomplete: 'off',
                         aria: {
                           label: t(:search),
                           describedby: 'q',
                         }
        %>
        </div>
    </div>
    <div>
        <%= f.label "Choisissez une institution :" %>
        <%= f.text_field "filters[organization][]", list: 'organizations_list', data: {action: 'change->search-bar#search'} %>
        <%= tag.datalist( options_for_select( @organizations.map { | item | [item.name, item.name] }), id: 'organizations_list') %>
    </div>

    <% end %>
</div>
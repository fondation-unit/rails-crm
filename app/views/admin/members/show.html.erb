<div class="d-flex w-100 flex-column justify-content-between">
    <h1>Fiche membre</h1>
    <div class="card-content">
        <div class="identity ">
            <div class="d-flex flex-row align-items-center">
                <i class="fa-solid fa-address-card"></i> <%= @member.gender+' '+@member.first_name+' '+@member.last_name %>
            </div>
            <div class="d-flex flex-row align-items-center">
                <i class="fa-solid fa-user-tie"></i> <%= @member.position %>
            </div>
        </div>
        <div class="d-flex flex-row align-items-center">
            <i class="fa-solid fa-envelope"></i> <%= mail_to @member.email_address, @member.email_address %>
        </div>
        <div class="d-flex flex-row align-items-center">
            <i class="fa-solid fa-phone"></i> <%= link_to @member.phone_number, "tel:#{@member.set_phone_link}" %>
        </div>
    </div>
    <div class="d-flex flex-row align-items-center">
        Membre du Copil : <%= @member.copil ? 'Oui': 'Non' %><br>
        Membre du ComEx : <%= @member.comex ? 'Oui': 'Non' %><br>
    </div>
    <% if Current&.session&.user %>
    <%= link_to 'Editer', edit_admin_member_path(@member), {class: "btn btn-primary"} %>
    <% end %>
</div>
</div>
</div>
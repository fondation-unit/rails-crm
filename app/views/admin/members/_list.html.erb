<table class="table">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">
        <%= I18n.t('members.institution') %>
      </th>
      <th scope="col">
        <%= I18n.t('first_name') %>
      </th>
    </tr>
  </thead>
  <tbody>
    <% records.each_with_index do |c, i| %>
      <tr>
        <td><%= i + 1 %></td>
        <td><%= raw c.organizations_names.map{|wl| link_to wl[:name], admin_organization_path(wl[:id])}.join(', ') %></td>
        <td><%= c.first_name %></td>
      </tr>
    <% end %>
  </tbody>
</table>
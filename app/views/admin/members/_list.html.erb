<table class="table">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">
        <%= 'Logo' %>
      </th>
      <th scope="col">
        <%= I18n.t('first_name') %>
      </th>
      <th scope="col">
        <%= I18n.t('last_name') %>
      </th>
      <th scope="col">
        <%= I18n.t('email_address') %>
      </th>
      <th scope="col">
        <%= I18n.t('phone_number') %>
      </th>
      <th scope="col">

      </th>
      <th scope="col">
      </th>
      <th scope="col">
      </th>
    </tr>
  </thead>
  <tbody>
    <% records.each_with_index do |c, i| %>
      <tr>
        <td><%= c.id %></td>
        <td><%= raw c.organizations_names.map{|wl| link_to wl[:name], admin_organization_path(wl[:id])}.join(', ') %></td>
        <td><%= c.first_name %></td>
        <td><%= c.last_name %></td>
        <td><%= c.email_address %></td>
        <td><%= c.phone_number %></td>
        <td><%= link_to I18n.t('notes.add'), admin_new_note_path(c.id) %></td>
        <td><%= link_to I18n.t('edit'), edit_admin_member_path(c) %></td>
        <td><%= link_to I18n.t('delete'),admin_member_path(c),data: { turbo_method: :delete, turbo_confirm: I18n.t('members.validation_delete'), } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
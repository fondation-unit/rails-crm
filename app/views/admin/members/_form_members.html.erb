<%= form_with url: url, method: method, model: member do |f| %>
<div class="form-group my-4">
    <%= f.label :first_name %>
    <%= f.text_field :first_name, required: true, class: 'form-control' %>
</div>
<div class="form-group my-4">
    <%= f.label :last_name %>
    <%= f.text_field :last_name, required: true, class: 'form-control' %>
</div>
<div class="form-group my-4">
    <%= f.label :email_address %>
    <%= f.email_field :email_address, required: true, class: 'form-control' %>
</div>
<div class="form-group my-4">
    <%= f.label :position %>
    <%= f.text_field :position, class: 'form-control' %>
</div>
<div class="form-group my-4">
    <%= f.label :phone_number %>
    <%= f.telephone_field :phone_number, class: 'form-control' %>
</div>
<div class="d-flex flex-row">
    <div class="col-md-4">
        <div class="form_group my-4">
            <div class="form-check">
                <%= f.label :copil %>
                <%= f.check_box :copil, as: :boolean %>
            </div>
        </div>
        <div class="form_group my-4">
            <div class="form-check">
                <%= f.label :comex %>
                <%= f.check_box :comex, as: :boolean %>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <%= f.label 'Institution' %>
        <div class="form_group my-4">
            <%=
      f.collection_select(
        :organization_ids,
        @organizations,
        :id,
        :name,
        { prompt: 'Sélectionnez une institution' },
        { multiple: true },
      )
    %>
        </div>
    </div>
    <div class="col-md-4">
        <% if member_types %>
        <%= f.label 'Type de membre' %>
        <div class="form_group my-4">
            <%=
        f.collection_check_boxes :member_type_ids, member_types,
          :id,
          :name,
          {} do |b| %>
            <div class="form-check">
                <%= b.check_box(class: 'form-check-input') %>
                <%= b.label(class: 'form-check-label') { b.object.name } %>
            </div>
            <% end %>
        </div>
        <% end %>
    </div>
</div>
<button type="submit" class="btn btn-primary">
    <% if member.persisted? %>
    Mettre à jour
    <% else %>
    Créer
    <% end %>
</button>
<% end %>
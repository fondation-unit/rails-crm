<%= form_with url: url, method: method, model: member do |f| %>

<div class="form-group">
    <%= f.label :name %>
    <%= f.text_field :name, class: "form-control"  %>
</div>
<div class="form-group my-4">
    <%= f.label :address %>
    <%= f.text_field :address, class: "form-control"  %>
</div>
<div class="form-group my-4">
    <%= f.label :zip_code %>
    <%= f.text_field :zip_code, class: "form-control"  %>
</div>
<div class="form-group my-4">
    <%= f.label :city %>
    <%= f.text_field :city, class: "form-control"  %>
</div>
<div class="form_group my-4">
    <%= f.label :logo %>
    <%= f.file_field :logo, class: "form-control-file" %>
</div>
<% if member_types %>
<%= f.label "Type de membre" %>
<div class="form_group my-4">
    <% member_types.each do  | mtype | %>
    <div class="form-check">
        <%= f.label mtype.name, class: "form-check-label" %>
        <%= check_box_tag "member_types[]", mtype.id, current_member_types.include?(mtype.id) ? true : false ,:id => "member_types_#{mtype.id}" %>
    </div>
    <% end %>
</div>
<% end %>
<button type="submit" class="btn btn-primary">
    <% if @member.persisted? %>
    Mettre à jour
    <% else %>
    Créer
    <% end %>
</button>
<% end %>
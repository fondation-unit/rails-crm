<div class="d-flex w-100 flex-column justify-content-between">
  <h1><%= @organization.name %></h1>

  <div class="d-flex flex-md-row flex-column">
    <div class="col-md-6">
      <% if @organization.logo.attached? %>
        <%= image_tag(@organization.logo.variant(:medium)) %>
      <%end%>
    </div>
    <div class="card coords col-md-6 p-4">
      <div class="d-flex flex-md-row align-items-start">
        <div class="content">
          <p>
            <%= @organization.address %>
            <br />
            <%= @organization.zip_code %>
            <br />
            <%= @organization.city %>
            <br />
            <%= I18n.t('members.organizations.linkedin') %> :
            <a href="<%= @organization.linkedin %>" target="_blank"><%= @organization.linkedin %></a>
            <br />
            <%= I18n.t('members.organizations.linkedin_connected_single') %>
            <%= @organization.linkedin_connected ? I18n.t('Yes') : I18n.t('No') %>
          </p>
        </div>
      </div>
    </div>
  </div>
  <h2 class="my-5">
    Les membres de
    <%= @organization.name %>
  </h2>
  <%=
    render 'shared/tables/sortable_table',
           headers: [
             [:id, '#'],
             [:first_name, 'Prénom'],
             [:last_name, 'Nom'],
             [:email_address, 'Adresse mail'],
             [:phone_number, 'Téléphone'],
             [:edit, ''],
           ],
           objects: @organization.members,
           pagy: @pagy,
           columns: %w[id first_name last_name email_address phone_number edit],
           formatters: {
             edit: ->(member) { link_to 'Editer', edit_admin_member_path(member) },
             email_address: ->(member) { mail_to member.email_address, member.email_address },
             first_name: ->(member) { link_to member.first_name, admin_member_path(member.id) },
             last_name: ->(member) { link_to member.last_name, admin_member_path(member.id) },
           }
  %>
  <div class="d-flex w-100 justify-content-between mt-5">
    <h2>Les notes de
      <%= @organization.name %></h2>
    <div>
      <%= link_to I18n.t('notes.add'), admin_new_organization_note_path(organization_id: @organization.id), { class: 'btn btn-info' } %>
    </div>
  </div>
  <%=
    render 'shared/tables/sortable_table',
           headers: [
             [:contact_type, I18n.t('notes.contact_type')],
             [:public, I18n.t('notes.public')],
             [:content, I18n.t('notes.content')],
             [:created_at, I18n.t('notes.created_at')],
             [:user_id, I18n.t('notes.created_by')],
             [:edit, ''],
             [:delete, ''],
           ],
           objects: @notes,
           pagy: @pagy2,
           columns: %w[contact_type public content created_at user_id edit delete],
           formatters: {
             edit: ->(note) { link_to I18n.t('edit'), admin_edit_organization_note_path(@organization,note) if is_current_user?(note.user&.id) },
             delete: ->(note) {
               if is_current_user?(note.user&.id)
                 link_to I18n.t('delete'),
                         admin_note_path(note),
                         data: {
                           turbo_method: :delete,
                           turbo_confirm: I18n.t('notes.validation_delete'),
                         }
               end
             },
             public: ->(note) {
               raw(
                 if note.public != true
                   '<i class="fa-solid fa-xmark text-danger"></i>'
                 else
                   '<i class="fa-solid fa-check text-success"></i>'
                 end,
                 )
             },
             created_at: ->(note) { date_readable(note.created_at) },
             content: ->(note) { note_excerpt(note.content) },
             user_id: ->(note) {
               is_current_user?(note.user&.id) ? I18n.t('notes.moi') : note.user.first_name + ' ' + note.user.last_name
             },
             contact_type: ->(note) { note.contact_type.present? ? I18n.t("notes.#{note.contact_type}") : '' },
           }
  %>
</div>

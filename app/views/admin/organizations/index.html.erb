<div class="d-flex w-100 justify-content-between">
  <h1 class="mb-4"><%= I18n.t('members.organizations.title') %></h1>
  <%= link_to I18n.t('members.organizations.add'), new_admin_organization_path, class: 'btn btn-primary align-self-center' %>
</div>
<%=
  render 'admin/organizations/tables/sortable_table',
         headers: [[:id, '#'], [:logo, 'Logo'], [:name, I18n.t('name')], [:address, I18n.t('address')], [:status, "Statut"], [:city, I18n.t('city')], [:edit, ''], [:delete, '']],
         objects: @records,
         pagy: @pagy,
         columns: %w[id logo_image name address status city edit delete],
         formatters: {
           name: ->(organization) { link_to organization.name, admin_organization_path(organization) },
           edit: ->(organization) { link_to I18n.t('edit'), edit_admin_organization_path(organization) },
           delete: ->(organization) {
             link_to I18n.t('delete'),
                     admin_organization_path(organization),
                     data: {
                       turbo_method: :delete,
                       turbo_confirm: I18n.t('members.organizations.validation_delete'),
                     }
           },
           logo_image: ->(organization) {
             if organization.logo.attached?
               image_tag(organization.logo.variant(:thumb), { style: 'max-width: 60px' })
             else
               nil
             end
           },
         }
%>
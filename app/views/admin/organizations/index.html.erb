<div class="d-flex w-100 justify-content-between">
  <h1 class="mb-4"><%= I18n.t('members.organizations.title') %></h1>
  <%=
    link_to I18n.t('members.organizations.add'), new_admin_organization_path, class: 'btn btn-primary align-self-center'
  %>
</div>
<%=
  render partial: 'admin/organizations/parts/search_bar_organizations',
         locals: {
           path: search_admin_organizations_path,
           translate: 'organizations',
           translate_list: 'organizations.statuses',
           filters: {
             status: Organization.statuses,
           },
         }
%>

<div id="search_results">
  <%= render 'list', records: @records %>
</div>

<div id="search_pagination" data-turbo-prefetch="false">
  <%= render 'shared/ui/pagy', pagy: @pagy %>
</div>

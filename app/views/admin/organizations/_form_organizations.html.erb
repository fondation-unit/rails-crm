<%= form_with url: url, model: organization do |f| %>
  <div class="form_group my-4">
    <%= f.label :logo %>
    <%= f.file_field :logo, class: 'form-control-file' %>
  </div>

  <% if @organization.logo.attached? && @organization.logo.blob.persisted? %>
    <%= image_tag(url_for(@organization.logo.variant(:thumb))) %>

    <div class="form_group my-4">
      <div class="form-check">
        <%= f.check_box :remove_logo, class: 'form-check-input' %>
        <%= f.label :remove_logo, I18n.t('members.organizations.remove_logo'), class: 'form-check-label' %>
      </div>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, I18n.t('name') %>
    <%= f.text_field :name, required: true, class: 'form-control' %>
  </div>
  <div class="form-group my-4">
    <%= f.label :address, I18n.t('address') %>
    <%= f.text_field :address, required: true, class: 'form-control' %>
  </div>
  <div class="form-group my-4">
    <%= f.label :zip_code, I18n.t('zip_code') %>
    <%= f.text_field :zip_code, required: true, class: 'form-control' %>
  </div>
  <div class="form-group my-4">
    <%= f.label :city, I18n.t('city') %>
    <%= f.text_field :city, required: true, class: 'form-control' %>
  </div>
  <div class="form-group my-4">
    <%= f.label :lat, I18n.t('members.organizations.lat') %>
    <%= f.text_field :lat, class: 'form-control' %>
  </div>
  <div class="form-group my-4">
    <%= f.label :lng, I18n.t('members.organizations.lng') %>
    <%= f.text_field :lng, class: 'form-control' %>
  </div>
  <div class="form-group my-4">
    <%= f.label :linkedin, I18n.t('members.organizations.linkedin') %>
    <%= f.text_field :linkedin, class: 'form-control' %>
  </div>
  <div class="form_group my-4">
    <div class="form-check">
      <%= f.check_box :linkedin_connected, class: 'form-check-input' %>
      <%= f.label :linkedin_connected, class: 'form-check-label' %>
    </div>
  </div>
  <div class="form-group my-4">
    <%= f.label :status, I18n.t('members.organizations.status') %>
    <%= f.select :status, Organization.statuses.keys %>
  </div>
  <button type="submit" class="btn btn-primary mb-5">
    <% if @organization.persisted? %>
      <%= I18n.t('update') %>
    <% else %>
      <%= I18n.t('create') %>
    <% end %>
  </button>
<% end %>

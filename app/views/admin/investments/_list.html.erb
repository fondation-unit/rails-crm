<table class="table" data-controller="sortable">
    <thead>
        <tr>
            <th scope="col" data-action="click->sortable#sort" data-sortable-column-value="<%= 'id' %>">#</th>
            <th scope="col" data-action="click->sortable#sort" data-sortable-column-value="<%= 'name' %>">
                <%= I18n.t('name') %>
            </th>
            <th scope="col" data-action="click->sortable#sort" data-sortable-column-value="<%= 'email_address' %>">
                <%= I18n.t('email_address') %>
            </th>
            <th scope="col"></th>
            <th scope="col"></th>
        </tr>
    </thead>
    <tbody>
        <% records.each_with_index do |c| %>
        <tr>
            <td><%= c.id %></td>
            <td><%= c.name %></td>
            <td><%= c.email_address %></td>
            <td><%= link_to I18n.t('edit'), edit_admin_investment_path(c) %></td>
            <td>
                <%=
            link_to I18n.t('delete'),
                    admin_investment_path(c),
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: I18n.t('investments.validation_delete'),
                    }
          %>
            </td>
        </tr>
        <% end %>
    </tbody>
</table>
<table class="table" data-controller="sortable">
    <thead>
        <tr>
            <% headers.each do |header, name| %>
            <th scope="col" data-action="click->sortable#sort" data-sortable-column-value="<%= header %>">
                <%= name %>
            </th>
            <% end %>
        </tr>
    </thead>
    <tbody>
        <% if objects %>
        <% objects.each do |obj| %>
        <tr>
            <% columns.each do |col| %>
            <% if defined?(formatters) && formatters&.key?(col.to_sym) %>
            <td><%= formatters[col.to_sym].call(obj) %></td>
            <% else %>
            <td><%= obj.send(col) %></td>
            <% end %>
            <% end %>
            <td></td>
        </tr>
        <% end %>
        <% end %>
    </tbody>
</table>
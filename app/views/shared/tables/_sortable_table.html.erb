<table class="table" data-controller="sortable">
  <thead>
    <tr>
      <% headers.each do |header, name| %>
        <th
          scope="col"
          data-action="click->sortable#sort"
          data-sortable-column-value="<%= header %>"
        >
          <%= name %>
        </th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% objects.each do |obj| %>
      <tr>
        <% columns.each do |col| %>
          <% if formatters&.key?(col.to_sym) %>
            <td><%= formatters[col.to_sym].call(obj) %></td>
          <% else %>
            <td><%= obj.send(col) %></td>
          <% end %>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
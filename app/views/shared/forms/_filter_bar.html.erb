<%= form_with url: path, method: :post do |f| %>
  <div class="d-flex">
    <ul class="list-group">
      <% filters.each do |filter_name, values| %>
        <li class="list-group-item active">
          <strong><%= filter_name.to_s.humanize %></strong>
        </li>

        <% values.each do |key, value| %>
          <li class="list-group-item">
            <label class="d-flex align-items-center">
              <%=
                check_box_tag "filters[#{filter_name}][]",
                              value,
                              Array(current_filters[filter_name]).map(&:to_s).include?(value.to_s),
                              class: 'me-2'
              %>
              <span>
                <%= key.humanize %>
              </span>
            </label>
          </li>
        <% end %>
      <% end %>
    </ul>
  </div>

  <%= submit_tag t(:filter), class: 'btn btn-primary mt-3' %>
<% end %>

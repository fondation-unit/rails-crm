<%# stimulus controller "search-bar" %>
<div data-controller="search-bar">
    <%= form_with url: path, method: :get, data: { "search-bar-target": "form" } do |f| %>

    <div class="d-flex">
        <ul class="list-group">
            <% filters.each do |filter_name, values| %>
            <li class="list-group-item active">
                <strong><%= I18n.t("members.#{translate}.#{filter_name}") %></strong>
            </li>

            <% values.each do |key, value| %>
            <li class="list-group-item">
                <label class="d-flex align-items-center">
                    <%= check_box_tag "filters[#{filter_name}][]", value, active_filter?(filter_name, value), class: 'me-2',data: { "action" => "input->filters[#{filter_name}][]#filter" } %>
                    <span>
                        <%= I18n.t("members.#{translate_list}.#{key}") %>
                    </span>
                </label>
            </li>
            <% end %>
            <% end %>
        </ul>
    </div>

    <% end %>
</div>